    { "id": "sac-policy", "from": "sac", "to": "policy", "label": "发布参数", "classification": "actor network", "variant": "emphasis" },
    { "id": "policy-robot", "from": "policy", "to": "robot", "label": "连续 + 夹爪动作", "classification": "5D action", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [960, 200] },
    { "id": "robot-replay", "from": "robot", "to": "online-buffer", "label": "新 transition", "classification": "online experience", "variant": "dashed", "route": "bottom-channel" }
