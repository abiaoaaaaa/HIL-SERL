      { "id": "reward-loop", "label": "01 奖励与终止", "focus": ["reward", "robot", "online-buffer"], "note": "分类器、脚踏板成功和 Esc 失败共同给稀疏奖励；成功或不可恢复失败终止 episode。" },
      { "id": "human-loop", "label": "02 人工干预", "focus": ["human", "robot", "online-buffer", "demo-buffer"], "note": "SpaceMouse 动作覆盖策略动作；干预 transition 同时进入在线 replay 与 demo buffer。" },
      { "id": "rlpd-batch", "label": "03 RLPD 混合采样", "focus": ["demo-buffer", "online-buffer", "mixed-batch", "sac"], "note": "Learner 各采一半 demo 与 online transition，拼成 50/50 batch；CTA ratio 让 critic 多更新。" },
      { "id": "sac-detail", "label": "04 SAC 优化", "focus": ["mixed-batch", "sac", "target-critic", "policy"], "note": "双 Q TD 目标训练 critic；actor 最大化 Q−αlogπ；temperature 自适应熵，target critic 软更新。" },
      { "id": "control-detail", "label": "05 控制执行", "focus": ["policy", "robot", "online-buffer"], "note": "策略动作先限幅与连续维 EMA，再由环境执行；replay 保存策略/干预动作和下一观测中的已执行动作。" }
    ]
  },
